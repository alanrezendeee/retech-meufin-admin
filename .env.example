# ==============================================
# MeuFin Admin — variáveis de ambiente (Vite)
# ==============================================

# Autenticação: o admin faz login na meufin-api (POST /api/v1/auth/login), que
# devolve um cookie de sessão HttpOnly. Nenhum token fica no browser.
# true = credenciais mock (demo@retechfin.com / demo123), sem API.
VITE_AUTH_USE_MOCK=true

# Base da meufin-api. Deixe VAZIA (recomendado): em dev o Vite faz proxy de /api/
# para API_PROXY_TARGET; em produção o nginx faz proxy para API_UPSTREAM.
# Só preencha em deploy cross-origin (exige CORS + SESSION_COOKIE_DOMAIN na API).
VITE_API_BASE_URL=

# Dev: destino do proxy /api/ do Vite (meufin-api local).
API_PROXY_TARGET=http://localhost:8002

# Produção (runtime do container nginx): destino do proxy /api/.
# Railway: http://<serviço-da-api>.railway.internal:<porta>
# API_UPSTREAM=http://localhost:8002

# Legado / outros (se existirem no projeto)
# VITE_API_URL=
# VITE_APP_NAME=ReTechFin Admin

# Apenas desenvolvimento: mostrar message da API em erros HTTP 5xx (padrão: mensagem genérica)
# VITE_SHOW_API_5XX_DETAILS=true
